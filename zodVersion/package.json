{
  "name": "openapi-zod-typed-express",
  "version": "1.2.0",
  "description": "Simple express runtime parser and documentation swagger generator with 100% support of Typescript static types",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check-code": "npm run test && npm run lint && npm run ts:check-types",
    "clean": "tsc --build --clean",
    "dev": "tsx watch example/server.ts",
    "dev:router": "tsx watch example/express-router-example.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "l": "npm run lint:fix",
    "lint": "biome check",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run clean && npm run build",
    "publish-lib": "npm publish",
    "test": "jest",
    "test:watch": "jest --watch",
    "ts:check-types": "tsc",
    "ts:check-types:watch": "tsc --watch",
    "ts:generate-api": "tsx npm_scripts/generate-ts-types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "express": "^5.2.1",
    "express-query-parser": "^1.3.3",
    "jest": "^30.4.2",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.2.2",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.12",
    "tsd": "^0.33.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "express": ">=5.0.0 <6.0.0",
    "zod": "^4.4.0"
  },
  "keywords": [
    "express",
    "typescript",
    "openapi",
    "documentation",
    "inferring",
    "zod",
    "infer",
    "validation",
    "http",
    "runtime-validation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Svehla/openapi-typed-express",
    "directory": "zodVersion"
  },
  "license": "MIT",
  "author": "Lukas Dadak",
  "contributors": [
    "Lukas Dadak",
    "Jakub Švehla"
  ],
  "main": "dist/index.js"
}
