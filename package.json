{
  "name": "openapi-zod-typed-express",
  "version": "2.0.0",
  "description": "Simple express runtime parser and documentation swagger generator with 100% support of Typescript static types",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check-code": "npm run test && npm run lint && npm run ts:check-types",
    "clean": "tsc --build --clean",
    "dev": "tsx watch example/server.ts",
    "dev:router": "tsx watch example/express-router-example.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "l": "npm run lint:fix",
    "lint": "biome check",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run clean && npm run build",
    "publish-lib": "npm publish",
    "test": "npm run ts:check-tests && jest",
    "test:jest": "jest",
    "test:watch": "jest --watch",
    "ts:check-tests": "tsc -p tsconfig.tests.json",
    "ts:check-types": "tsc",
    "ts:check-types:watch": "tsc --watch",
    "ts:generate-api": "tsx npm_scripts/generate-ts-types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "express": "^5.2.1",
    "express-query-parser": "^1.3.3",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsd": "^0.33.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "express": ">=5.0.0 <6.0.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "express",
    "typescript",
    "openapi",
    "documentation",
    "inferring",
    "zod",
    "infer",
    "validation",
    "http",
    "runtime-validation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Svehla/openapi-typed-express"
  },
  "license": "MIT",
  "author": "Lukas Dadak",
  "contributors": [
    "Lukas Dadak",
    "Jakub \u0160vehla"
  ],
  "main": "dist/index.js"
}
